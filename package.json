{
  "name": "seedance-porter",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Production toolkit and prompt intelligence layer for ByteDance Seedance",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "porter": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "studio": "tsx src/server/http.ts",
    "validate:library": "node scripts/validate-library.mjs",
    "validate:render": "node scripts/validate-render-contract.mjs",
    "case:import": "node scripts/import-case-candidates.mjs --limit 750 --min 500 --output studio/case-candidates.json",
    "case:augment": "node scripts/augment-case-candidates.mjs --input studio/case-candidates.json --output studio/case-candidates.json --limit 750",
    "case:expand": "node scripts/expand-case-candidates.mjs --input studio/case-candidates.json --output studio/case-candidates.json --limit 750",
    "case:queue": "node scripts/build-case-review-queue.mjs --input studio/case-candidates.json --limit 90 --output studio/case-review-queue.json",
    "coverage:plan": "node scripts/build-coverage-plan.mjs --corpus studio/case-candidates.json --queue studio/case-review-queue.json --output studio/coverage-plan.json --backlog 30",
    "source:health": "node scripts/build-source-health.mjs --corpus studio/case-candidates.json --plan studio/coverage-plan.json --output studio/source-health.json",
    "case:refresh": "node scripts/refresh-case-corpus.mjs --limit 750 --min 500 --queue 90 --backlog 30",
    "curation:build": "node scripts/build-curation-draft.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
