{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Seedance Porter Generation Evaluation Extensions",
  "type":"object",
  "additionalProperties":false,
  "required":["evaluations","comparisons","winners","retakes"],
  "properties":{
    "evaluations":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/evaluation"}},
    "comparisons":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/comparison"}},
    "winners":{"type":"object","maxProperties":100,"additionalProperties":{"$ref":"#/$defs/winner"}},
    "retakes":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/retake"}}
  },
  "$defs":{
    "boundedTextList":{"type":"array","maxItems":40,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}},
    "dimensionScore":{"type":"object","additionalProperties":false,"required":["score","note","evidence"],"properties":{"score":{"type":["integer","null"],"minimum":1,"maximum":5},"note":{"type":"string","maxLength":2000},"evidence":{"type":"string","maxLength":2000}}},
    "scores":{"type":"object","additionalProperties":false,"required":["task-adherence","identity-consistency","composition","camera","motion-action","timing-readability","continuity","material-physics","lighting-color","graphics-text-logo","audio-fit","artifact-severity","production-readiness"],"properties":{"task-adherence":{"$ref":"#/$defs/dimensionScore"},"identity-consistency":{"$ref":"#/$defs/dimensionScore"},"composition":{"$ref":"#/$defs/dimensionScore"},"camera":{"$ref":"#/$defs/dimensionScore"},"motion-action":{"$ref":"#/$defs/dimensionScore"},"timing-readability":{"$ref":"#/$defs/dimensionScore"},"continuity":{"$ref":"#/$defs/dimensionScore"},"material-physics":{"$ref":"#/$defs/dimensionScore"},"lighting-color":{"$ref":"#/$defs/dimensionScore"},"graphics-text-logo":{"$ref":"#/$defs/dimensionScore"},"audio-fit":{"$ref":"#/$defs/dimensionScore"},"artifact-severity":{"$ref":"#/$defs/dimensionScore"},"production-readiness":{"$ref":"#/$defs/dimensionScore"}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["id","taskId","exportHash","scores","overallScore","ratedDimensions","evidenceDimensions","decisionReady","verdict","strengths","weaknesses","artifactFlags","notes","createdAt","updatedAt"],"properties":{"id":{"type":"string","minLength":1},"taskId":{"type":"string","minLength":1},"exportHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"scores":{"$ref":"#/$defs/scores"},"overallScore":{"type":["number","null"],"minimum":1,"maximum":5},"ratedDimensions":{"type":"integer","minimum":0,"maximum":13},"evidenceDimensions":{"type":"integer","minimum":0,"maximum":13},"decisionReady":{"type":"boolean"},"verdict":{"enum":["candidate","retake","reject"]},"strengths":{"$ref":"#/$defs/boundedTextList"},"weaknesses":{"$ref":"#/$defs/boundedTextList"},"artifactFlags":{"$ref":"#/$defs/boundedTextList"},"notes":{"type":"string","maxLength":6000},"createdAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":["string","null"],"format":"date-time"}}},
    "comparison":{"type":"object","additionalProperties":false,"required":["id","label","taskIds","createdAt","updatedAt"],"properties":{"id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1,"maxLength":180},"taskIds":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}},"createdAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":["string","null"],"format":"date-time"}}},
    "winner":{"type":"object","additionalProperties":false,"required":["comparisonId","taskId","exportHash","reason","selectedAt"],"properties":{"comparisonId":{"type":"string","minLength":1},"taskId":{"type":"string","minLength":1},"exportHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reason":{"type":"string","minLength":1,"maxLength":3000},"selectedAt":{"type":["string","null"],"format":"date-time"}}},
    "retake":{"type":"object","additionalProperties":false,"required":["id","sourceTaskId","sourceExportHash","lever","changeInstruction","expectedImprovement","retainedLocks","status","createdAt","updatedAt"],"properties":{"id":{"type":"string","minLength":1},"sourceTaskId":{"type":"string","minLength":1},"sourceExportHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"lever":{"enum":["objective","subject","environment","composition","camera","action","timing","lighting","materials","style","continuity","constraints","avoid","references","provider-settings","other"]},"changeInstruction":{"type":"string","minLength":1,"maxLength":5000},"expectedImprovement":{"type":"string","minLength":1,"maxLength":3000},"retainedLocks":{"type":"array","minItems":1,"maxItems":40,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}},"status":{"const":"draft"},"createdAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":["string","null"],"format":"date-time"}}}
  }
}
