{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Seedance Porter Generation Batch Job",
  "type":"object",
  "additionalProperties":false,
  "required":["kind","schemaVersion","batchId","planHash","project","status","localConcurrency","createdAt","updatedAt","completedAt","items","policy"],
  "properties":{
    "kind":{"const":"seedance-porter-generation-batch-job"},
    "schemaVersion":{"const":1},
    "batchId":{"type":"string","minLength":1},
    "planHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "project":{"type":"object"},
    "status":{"enum":["pending","running","needs-resume","needs-review","succeeded","completed-with-errors"]},
    "localConcurrency":{"type":"integer","minimum":1,"maximum":8},
    "createdAt":{"type":"string","format":"date-time"},
    "updatedAt":{"type":"string","format":"date-time"},
    "completedAt":{"type":["string","null"],"format":"date-time"},
    "items":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/item"}},
    "policy":{"type":"object","additionalProperties":false,"required":["secretPersisted","apiKeySource","externalExecution","automaticRetry","ambiguousSubmissionRetry"],"properties":{"secretPersisted":{"const":false},"apiKeySource":{"const":"environment"},"externalExecution":{"const":true},"automaticRetry":{"const":false},"ambiguousSubmissionRetry":{"const":false}}}
  },
  "$defs":{"item":{"type":"object","additionalProperties":false,"required":["itemId","variant","exportHash","status","job","result","error","startedAt","updatedAt","completedAt"],"properties":{"itemId":{"type":"string","minLength":1},"variant":{"type":"object"},"exportHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["pending","submitting","submitted","queued","running","unknown","interrupted","submission-uncertain","blocked","succeeded","failed","cancelled","expired"]},"job":{"type":["object","null"]},"result":{"type":["object","null"]},"error":{"type":["object","null"]},"startedAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"completedAt":{"type":["string","null"],"format":"date-time"}},"allOf":[{"if":{"properties":{"status":{"enum":["succeeded","failed","cancelled","expired"]}},"required":["status"]},"then":{"properties":{"job":{"type":"object"},"result":{"type":"object"},"completedAt":{"type":"string","format":"date-time"}}}},{"if":{"properties":{"status":{"const":"submission-uncertain"}},"required":["status"]},"then":{"properties":{"job":{"type":"null"},"result":{"type":"null"},"completedAt":{"type":"string","format":"date-time"}}}},{"if":{"properties":{"status":{"const":"blocked"}},"required":["status"]},"then":{"properties":{"result":{"type":"null"},"completedAt":{"type":"string","format":"date-time"}}}}]}},
  "allOf":[
    {"if":{"properties":{"status":{"enum":["succeeded","completed-with-errors"]}},"required":["status"]},"then":{"properties":{"completedAt":{"type":"string","format":"date-time"}}}},
    {"if":{"properties":{"status":{"enum":["pending","running","needs-resume","needs-review"]}},"required":["status"]},"then":{"properties":{"completedAt":{"type":"null"}}}}
  ]
}
