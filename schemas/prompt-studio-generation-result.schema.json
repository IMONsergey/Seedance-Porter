{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Seedance Porter Generation Result",
  "type":"object",
  "additionalProperties":false,
  "required":["kind","schemaVersion","provider","adapter","taskId","status","succeeded","terminal","exportHash","output","usage","error","providerMeta","createdAt","completedAt","recordedAt","policy"],
  "properties":{
    "kind":{"const":"seedance-porter-generation-result"},
    "schemaVersion":{"const":1},
    "provider":{"const":"byteplus-modelark"},
    "adapter":{"const":"seedance-2.0"},
    "taskId":{"type":"string","minLength":1},
    "status":{"enum":["succeeded","failed","cancelled","expired"]},
    "succeeded":{"type":"boolean"},
    "terminal":{"const":true},
    "exportHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "studioLink":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/studioLink"}]},
    "output":{"type":["object","null"],"additionalProperties":false,"properties":{"videoUrl":{"type":"string"},"lastFrameUrl":{"type":"string"}}},
    "usage":{"type":["object","null"],"additionalProperties":false,"properties":{"completionTokens":{"type":["number","null"]},"totalTokens":{"type":["number","null"]}}},
    "error":{"type":["object","null"],"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string","maxLength":1000}}},
    "providerMeta":{"type":["object","null"],"additionalProperties":false,"properties":{"model":{"type":"string"},"createdAt":{"type":["string","null"],"format":"date-time"},"updatedAt":{"type":["string","null"],"format":"date-time"},"resolution":{"type":"string"},"ratio":{"type":"string"},"duration":{"type":["number","null"]},"framesPerSecond":{"type":["number","null"]},"generateAudio":{"type":["boolean","null"]},"priority":{"type":["number","null"]},"executionExpiresAfter":{"type":["number","null"]}}},
    "createdAt":{"type":"string","format":"date-time"},
    "completedAt":{"type":"string","format":"date-time"},
    "recordedAt":{"type":"string","format":"date-time"},
    "policy":{"type":"object","additionalProperties":false,"required":["secretPersisted","externalExecution"],"properties":{"secretPersisted":{"const":false},"externalExecution":{"const":true}}}
  },
  "$defs":{"studioLink":{"type":"object","additionalProperties":false,"required":["projectId","projectUpdatedAt","handoffHash"],"properties":{"projectId":{"type":"string","minLength":1},"projectUpdatedAt":{"type":"string","format":"date-time"},"handoffHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
  "allOf":[
    {"if":{"properties":{"status":{"const":"succeeded"}},"required":["status"]},"then":{"properties":{"succeeded":{"const":true},"output":{"type":"object","required":["videoUrl","lastFrameUrl"]}}}},
    {"if":{"properties":{"status":{"enum":["failed","cancelled","expired"]}},"required":["status"]},"then":{"properties":{"succeeded":{"const":false}}}}
  ]
}
