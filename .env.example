# Preferred direct BytePlus / ModelArk route
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Also accepted for BytePlus compatibility
SEEDANCE_API_KEY=
ARK_API_KEY=

# fal.ai stable router for Seedance 2.0
FAL_KEY=

# Experimental third-party Seedance 2.5 preview route
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai/api/v1

# Porter defaults
PORTER_PROVIDER=byteplus
PORTER_MODEL=seedance-2.0
PORTER_OUTPUT_DIR=outputs
PORTER_POLL_INTERVAL_MS=5000
PORTER_TIMEOUT_MS=900000

# Local Studio / HTTP API
PORTER_HOST=127.0.0.1
PORTER_PORT=4173
# Optional bearer token if you intentionally bind outside localhost.
PORTER_STUDIO_TOKEN=
